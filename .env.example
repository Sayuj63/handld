# ─────────────────────────────────────────────────────────────
# handld — environment configuration
# Copy to .env.local and fill in. All values are required unless
# marked (optional).
# ─────────────────────────────────────────────────────────────

# --- Core ---
# Postgres connection string (Neon / Supabase / local).
# For Neon use the pooled connection string from
# Console → Connection Details → "Pooled connection".
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Better Auth secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of the app (used for invite links + email links).
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email address promoted to Super Admin by `npm run db:seed`.
SUPER_ADMIN_EMAIL=

# --- Email (Resend) — (optional; emails are logged to console when unset) ---
RESEND_API_KEY=
EMAIL_FROM=handld <onboarding@resend.dev>  # no domain yet — Resend's test sender (delivers to your own email only). Swap to no-reply@yourdomain.com once you verify a domain.

# --- Rate limiting — (optional; falls back to in-process limiter when unset) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Object storage (Cloudflare R2) — (optional; local disk used when unset) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
